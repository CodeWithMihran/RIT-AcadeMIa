<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Subject | RIT AcadeMIA Console</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #1a1a1a;
            background-color: #fbfbfa;
            scroll-behavior: smooth;
        }
        .notion-input {
            border: 1px solid #e5e7eb;
            background: white;
            transition: all 0.2s ease;
        }
        .notion-input:focus {
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.05);
        }
        .unit-editor-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-left: 4px solid #3b82f6;
            transition: all 0.3s ease;
        }
        .section-label {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: #9ca3af;
        }
    </style>
</head>

<body class="min-h-screen">

    <%- include("partials/navbar-admin") %>

    <div class="max-w-6xl mx-auto px-6 pt-32 pb-20">
        
        <div class="mb-12 border-b border-gray-100 pb-10" data-aos="fade-up">
            <div class="flex items-center gap-4 mb-4">
                <a href="/admin" class="text-xs font-bold text-gray-400 hover:text-black transition-colors uppercase tracking-widest">← Back to Console</a>
            </div>
            <h1 class="text-4xl font-black tracking-tighter text-[#1a1a1a] italic">
                Edit <span class="text-blue-600 not-italic">Subject</span>
            </h1>
            <p class="text-gray-500 mt-2 font-medium">Modifying resources for: <span class="text-black font-bold underline underline-offset-4"><%= subject.name %></span></p>
        </div>

        <% if (error.length > 0) { %>
            <div class="bg-red-50 border border-red-100 text-red-600 px-5 py-4 rounded-2xl mb-8 text-sm font-bold flex items-center gap-3">
                <span>⚠️</span> <%= error %>
            </div>
        <% } %>

        <% if (success.length > 0) { %>
            <div class="bg-green-50 border border-green-100 text-green-600 px-5 py-4 rounded-2xl mb-8 text-sm font-bold flex items-center gap-3">
                <span>✅</span> <%= success %>
            </div>
        <% } %>

        <form action="/subjects/edit/<%= subject._id %>" method="POST" class="space-y-12" data-aos="fade-up">
            
            <div class="bg-white border border-gray-200 rounded-[2.5rem] p-8 md:p-10 shadow-sm">
                <h2 class="section-label mb-8">Base Configuration</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="space-y-2">
                        <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider">Subject Name</label>
                        <input type="text" name="name" value="<%= subject.name %>" required
                            class="notion-input w-full px-4 py-3 rounded-xl text-sm font-bold">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider">Branch</label>
                        <input type="text" name="branch" value="<%= subject.branch %>" required
                            class="notion-input w-full px-4 py-3 rounded-xl text-sm font-bold">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[11px] font-black text-gray-400 uppercase tracking-wider">Semester</label>
                        <input type="number" name="semester" value="<%= subject.semester %>" required
                            class="notion-input w-full px-4 py-3 rounded-xl text-sm font-bold">
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <h2 class="section-label">Resource Architecture</h2>
                <div class="h-[1px] flex-grow bg-gray-100"></div>
            </div>

            <div class="space-y-10">
                <% if(subject.units && subject.units.length > 0){ %>
                    <% subject.units.forEach((unit, uIndex) => { %>
                        <div class="unit-editor-card rounded-[2.5rem] p-8 md:p-12 shadow-sm space-y-10">
                            
                            <div class="flex justify-between items-center border-b border-gray-50 pb-6">
                                <h3 class="text-2xl font-black italic tracking-tighter">Unit 0<%= unit.unitNumber %></h3>
                                <input type="hidden" name="units[<%= uIndex %>][unitNumber]" value="<%= unit.unitNumber %>">
                                <span class="bg-blue-50 text-blue-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest">Active Module</span>
                            </div>

                            <div class="grid md:grid-cols-2 gap-8">
                                <div class="space-y-2">
                                    <label class="section-label text-gray-600">Module Title</label>
                                    <input name="units[<%= uIndex %>][unitTitle]" value="<%= unit.unitTitle %>"
                                        class="notion-input w-full px-4 py-3 rounded-xl text-sm font-medium">
                                </div>
                                <div class="space-y-2">
                                    <label class="section-label text-gray-600">Topic Index</label>
                                    <input name="units[<%= uIndex %>][topics]" 
                                        value="<%= unit.topics ? unit.topics.map(t => t.title).join(', ') : '' %>"
                                        class="notion-input w-full px-4 py-3 rounded-xl text-sm font-medium">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                
                                <div class="p-6 bg-blue-50/30 rounded-3xl border border-blue-100/50 space-y-4">
                                    <p class="section-label text-blue-600">Study Notes</p>
                                    <% if(unit.notes){ unit.notes.forEach((note, nIndex) => { %>
                                        <div class="space-y-2">
                                            <input name="units[<%= uIndex %>][notes][<%= nIndex %>][title]" value="<%= note.title %>"
                                                class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold" placeholder="Title">
                                            <input name="units[<%= uIndex %>][notes][<%= nIndex %>][link]" value="<%= note.link %>"
                                                class="notion-input w-full px-3 py-2 rounded-lg text-xs" placeholder="URL">
                                        </div>
                                    <% }) } %>
                                </div>

                                <div class="p-6 bg-purple-50/30 rounded-3xl border border-purple-100/50 space-y-4">
                                    <p class="section-label text-purple-600">Reference Books</p>
                                    <% if(unit.books){ unit.books.forEach((book, bIndex) => { %>
                                        <div class="space-y-2">
                                            <input name="units[<%= uIndex %>][books][<%= bIndex %>][title]" value="<%= book.title %>"
                                                class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold">
                                            <input name="units[<%= uIndex %>][books][<%= bIndex %>][link]" value="<%= book.link %>"
                                                class="notion-input w-full px-3 py-2 rounded-lg text-xs">
                                        </div>
                                    <% }) } %>
                                </div>

                                <div class="p-6 bg-red-50/30 rounded-3xl border border-red-100/50 space-y-4">
                                    <p class="section-label text-red-600">University PYQs</p>
                                    <% if(unit.pyqs){ unit.pyqs.forEach((pyq, pIndex) => { %>
                                        <div class="space-y-2">
                                            <input name="units[<%= uIndex %>][pyqs][<%= pIndex %>][title]" value="<%= pyq.title %>"
                                                class="notion-input w-full px-3 py-2 rounded-lg text-xs font-bold">
                                            <input name="units[<%= uIndex %>][pyqs][<%= pIndex %>][link]" value="<%= pyq.link %>"
                                                class="notion-input w-full px-3 py-2 rounded-lg text-xs">
                                        </div>
                                    <% }) } %>
                                </div>

                                <div class="p-6 bg-gray-900 rounded-3xl space-y-4">
                                    <p class="section-label text-red-500">Video Tutorials</p>
                                    <% if(unit.youtubeLinks){ unit.youtubeLinks.forEach((video, vIndex) => { %>
                                        <div class="space-y-2">
                                            <input name="units[<%= uIndex %>][youtubeLinks][<%= vIndex %>][title]" value="<%= video.title %>"
                                                class="notion-input !bg-white/5 !border-white/10 !text-white w-full px-3 py-2 rounded-lg text-xs font-bold">
                                            <input name="units[<%= uIndex %>][youtubeLinks][<%= vIndex %>][link]" value="<%= video.link %>"
                                                class="notion-input !bg-white/5 !border-white/10 !text-blue-400 w-full px-3 py-2 rounded-lg text-xs">
                                        </div>
                                    <% }) } %>
                                </div>

                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="notion-card p-12 rounded-[2rem] text-center italic text-gray-400">No units detected for this entity.</div>
                <% } %>
            </div>

            <div class="pt-10 flex justify-center">
                <button class="bg-[#0a0a0a] text-white px-12 py-5 rounded-[2rem] font-black uppercase tracking-[0.3em] text-xs hover:bg-blue-600 transition-all shadow-2xl shadow-gray-300 active:scale-95">
                    Commit Changes to Vault
                </button>
            </div>

        </form>
    </div>

    <%- include("partials/footer-admin") %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, once: true });
    </script>
</body>
</html>